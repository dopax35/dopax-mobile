# Copy to .env.local. Never commit .env.local.

# Where the DopaX backend is reachable from the Next.js *server*, not from the
# browser. The browser never talks to the backend directly and never holds a
# staff token: every call goes through this app's server, which keeps the token
# in an httpOnly cookie. That is the whole reason the console is a server app.
BACKEND_URL=http://localhost:8080

# ─── Firebase web sign-in (R1: staff authenticate the same way everyone does) ──
# From the Firebase console → Project settings → your web app. Public by design;
# they identify the project, they do not authorise anything. Authorisation is the
# staff_users allowlist in the backend.
#
# Leave unset to hide the Google sign-in button — useful on a laptop with no
# Firebase access, where the backend's ADMIN_DEV_LOGIN path is used instead.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=dopa-x-app.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=dopa-x-app
