<?xml version="1.0" encoding="utf-8"?>
<!--
    English QWERTY keyboard layout for PDKeyboardService.

    Row 4 action keys:
      - KEYCODE_LANG_TOGGLE    (-100) → switch to Hebrew layout
      - KEYCODE_NUMBERS_TOGGLE (-101) → switch to numbers/symbols page
      - KEYCODE_MODE_CHANGE    (-2)   → open Android IME picker (globe)
      - Space (32), Enter (10)

    Long-press (popupCharacters) gives quick access to digits (row 1, matching
    each key's column) and common accented letters, without leaving the
    keyboard to visit the numbers page.
-->
<Keyboard xmlns:android="http://schemas.android.com/apk/res/android"
    android:keyWidth="10%p"
    android:keyHeight="52dp"
    android:horizontalGap="0px"
    android:verticalGap="0px">

    <!-- ── Row 1 ── -->
    <Row>
        <Key android:codes="113" android:keyLabel="q" android:keyEdgeFlags="left" android:popupCharacters="1"/>
        <Key android:codes="119" android:keyLabel="w" android:popupCharacters="2"/>
        <Key android:codes="101" android:keyLabel="e" android:popupCharacters="3éèê"/>
        <Key android:codes="114" android:keyLabel="r" android:popupCharacters="4"/>
        <Key android:codes="116" android:keyLabel="t" android:popupCharacters="5"/>
        <Key android:codes="121" android:keyLabel="y" android:popupCharacters="6"/>
        <Key android:codes="117" android:keyLabel="u" android:popupCharacters="7üúù"/>
        <Key android:codes="105" android:keyLabel="i" android:popupCharacters="8íìî"/>
        <Key android:codes="111" android:keyLabel="o" android:popupCharacters="9óòô"/>
        <Key android:codes="112" android:keyLabel="p" android:keyEdgeFlags="right" android:popupCharacters="0"/>
    </Row>

    <!-- ── Row 2 ── -->
    <Row>
        <Key android:codes="97"  android:keyLabel="a" android:keyEdgeFlags="left" android:horizontalGap="5%p" android:keyWidth="9%p" android:popupCharacters="áàâ"/>
        <Key android:codes="115" android:keyLabel="s" android:keyWidth="9%p" android:popupCharacters="ß"/>
        <Key android:codes="100" android:keyLabel="d" android:keyWidth="9%p"/>
        <Key android:codes="102" android:keyLabel="f" android:keyWidth="9%p"/>
        <Key android:codes="103" android:keyLabel="g" android:keyWidth="9%p"/>
        <Key android:codes="104" android:keyLabel="h" android:keyWidth="9%p"/>
        <Key android:codes="106" android:keyLabel="j" android:keyWidth="9%p"/>
        <Key android:codes="107" android:keyLabel="k" android:keyWidth="9%p"/>
        <Key android:codes="108" android:keyLabel="l" android:keyWidth="9%p" android:keyEdgeFlags="right"/>
    </Row>

    <!-- ── Row 3 ── -->
    <Row>
        <Key android:codes="-1"
             android:keyLabel="⇧"
             android:keyWidth="15%p"
             android:keyEdgeFlags="left"
             android:isModifier="true"
             android:isSticky="true"/>
        <Key android:codes="122" android:keyLabel="z" android:keyWidth="8.6%p"/>
        <Key android:codes="120" android:keyLabel="x" android:keyWidth="8.6%p"/>
        <Key android:codes="99"  android:keyLabel="c" android:keyWidth="8.6%p" android:popupCharacters="ç"/>
        <Key android:codes="118" android:keyLabel="v" android:keyWidth="8.6%p"/>
        <Key android:codes="98"  android:keyLabel="b" android:keyWidth="8.6%p"/>
        <Key android:codes="110" android:keyLabel="n" android:keyWidth="8.6%p" android:popupCharacters="ñ"/>
        <Key android:codes="109" android:keyLabel="m" android:keyWidth="8.6%p"/>
        <Key android:codes="-5"
             android:keyLabel="⌫"
             android:keyWidth="15%p"
             android:keyEdgeFlags="right"
             android:isRepeatable="true"/>
    </Row>

    <!-- ── Row 4: action row ── -->
    <Row android:rowEdgeFlags="bottom">
        <!-- Language toggle: switch to Hebrew layout -->
        <Key android:codes="-100"
             android:keyLabel="עA"
             android:keyWidth="13%p"
             android:keyEdgeFlags="left"/>
        <!-- Numbers / symbols page -->
        <Key android:codes="-101"
             android:keyLabel="?123"
             android:keyWidth="14%p"/>
        <!-- Globe: show IME picker -->
        <Key android:codes="-2"
             android:keyLabel="🌐"
             android:keyWidth="11%p"/>
        <Key android:codes="32"
             android:keyLabel="SPACE"
             android:keyWidth="32%p"
             android:isRepeatable="false"/>
        <Key android:codes="46"  android:keyLabel="." android:keyWidth="10%p" android:popupCharacters=",;"/>
        <Key android:codes="10"  android:keyLabel="↵" android:keyWidth="20%p" android:keyEdgeFlags="right"/>
    </Row>

</Keyboard>
