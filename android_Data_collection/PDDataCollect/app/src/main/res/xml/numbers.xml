<?xml version="1.0" encoding="utf-8"?>
<!--
    Numbers / symbols page for PDKeyboardService.
    Reached via the "?123" key on the letter layouts; "ABC" returns to
    whichever letter layout (English or Hebrew) was active before.
-->
<Keyboard xmlns:android="http://schemas.android.com/apk/res/android"
    android:keyWidth="10%p"
    android:keyHeight="52dp"
    android:horizontalGap="0px"
    android:verticalGap="0px">

    <!-- Row 1: digits -->
    <Row>
        <Key android:codes="49" android:keyLabel="1" android:keyEdgeFlags="left"/>
        <Key android:codes="50" android:keyLabel="2"/>
        <Key android:codes="51" android:keyLabel="3"/>
        <Key android:codes="52" android:keyLabel="4"/>
        <Key android:codes="53" android:keyLabel="5"/>
        <Key android:codes="54" android:keyLabel="6"/>
        <Key android:codes="55" android:keyLabel="7"/>
        <Key android:codes="56" android:keyLabel="8"/>
        <Key android:codes="57" android:keyLabel="9"/>
        <Key android:codes="48" android:keyLabel="0" android:keyEdgeFlags="right"/>
    </Row>

    <!-- Row 2: common symbols -->
    <Row>
        <Key android:codes="64" android:keyLabel="@" android:keyEdgeFlags="left"/>
        <Key android:codes="35" android:keyLabel="#"/>
        <Key android:codes="36" android:keyLabel="$"/>
        <Key android:codes="95" android:keyLabel="_"/>
        <Key android:codes="38" android:keyLabel="&amp;"/>
        <Key android:codes="45" android:keyLabel="-"/>
        <Key android:codes="43" android:keyLabel="+"/>
        <Key android:codes="40" android:keyLabel="("/>
        <Key android:codes="41" android:keyLabel=")"/>
        <Key android:codes="47" android:keyLabel="/" android:keyEdgeFlags="right"/>
    </Row>

    <!-- Row 3: backspace + punctuation -->
    <Row>
        <Key android:codes="-5"
             android:keyLabel="⌫"
             android:keyWidth="15%p"
             android:keyEdgeFlags="left"
             android:isRepeatable="true"/>
        <Key android:codes="42" android:keyLabel="*" android:keyWidth="9.44%p"/>
        <Key android:codes="34" android:keyLabel="&quot;" android:keyWidth="9.44%p"/>
        <Key android:codes="39" android:keyLabel="'" android:keyWidth="9.44%p"/>
        <Key android:codes="58" android:keyLabel=":" android:keyWidth="9.44%p"/>
        <Key android:codes="59" android:keyLabel=";" android:keyWidth="9.44%p"/>
        <Key android:codes="33" android:keyLabel="!" android:keyWidth="9.44%p"/>
        <Key android:codes="63" android:keyLabel="?" android:keyWidth="9.44%p"/>
        <Key android:codes="37" android:keyLabel="%" android:keyWidth="9.44%p" android:keyEdgeFlags="right"/>
    </Row>

    <!-- Row 4: action row -->
    <Row android:rowEdgeFlags="bottom">
        <!-- Back to letters (English or Hebrew, whichever was active) -->
        <Key android:codes="-101"
             android:keyLabel="ABC"
             android:keyWidth="16%p"
             android:keyEdgeFlags="left"/>
        <!-- Globe: show IME picker -->
        <Key android:codes="-2"
             android:keyLabel="🌐"
             android:keyWidth="12%p"/>
        <Key android:codes="32"
             android:keyLabel="SPACE"
             android:keyWidth="42%p"
             android:isRepeatable="false"/>
        <Key android:codes="46" android:keyLabel="." android:keyWidth="10%p" android:popupCharacters=",;"/>
        <Key android:codes="10"  android:keyLabel="↵" android:keyWidth="20%p" android:keyEdgeFlags="right"/>
    </Row>

</Keyboard>
