<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:paddingHorizontal="24dp"
    android:paddingBottom="28dp">

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingTop="40dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <ImageView
                android:layout_width="96dp"
                android:layout_height="96dp"
                android:background="@drawable/bg_onboarding_circle"
                android:contentDescription="@null"
                android:padding="27dp"
                android:src="@drawable/ic_onboarding_touch" />

            <TextView
                style="@style/Widget.DopaX.Onboarding.Title"
                android:layout_marginTop="28dp"
                android:gravity="center"
                android:text="How you use your phone" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:fontFamily="@font/lexend"
                android:gravity="center"
                android:text="dopa-X reads simple interaction signals, like typing rhythm and scrolling, to notice changes over time."
                android:textColor="@color/black_70"
                android:textSize="15sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:background="@drawable/bg_onboarding_surface"
                android:orientation="vertical"
                android:padding="18dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/lexend_medium"
                    android:text="What we never do"
                    android:textColor="@color/black_90"
                    android:textSize="14sp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:fontFamily="@font/lexend"
                    android:text="Never reads what you type. Never sees messages or passwords. Only rhythm and movement patterns."
                    android:textColor="@color/black_70"
                    android:textSize="14sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/rowInteractionAccess"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:background="@drawable/bg_onboarding_surface"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="16dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/lexend_medium"
                        android:text="Interaction access"
                        android:textColor="@color/black_90"
                        android:textSize="15sp" />

                    <TextView
                        android:id="@+id/tvInteractionStatus"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/lexend"
                        android:text="Required for typing rhythm"
                        android:textColor="@color/black_70"
                        android:textSize="13sp" />
                </LinearLayout>

                <TextView
                    android:id="@+id/btnOpenInteractionSettings"
                    android:layout_width="wrap_content"
                    android:layout_height="44dp"
                    android:background="@drawable/bg_onboarding_connect_pill"
                    android:fontFamily="@font/lexend_bold"
                    android:gravity="center"
                    android:minWidth="104dp"
                    android:paddingHorizontal="16dp"
                    android:text="Open Settings"
                    android:textColor="@color/onboarding_accent"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/tvInteractionGranted"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/lexend_bold"
                    android:text="✓"
                    android:textColor="@color/onboarding_accent"
                    android:textSize="18sp"
                    android:visibility="gone" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/rowUsageAccess"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_onboarding_surface"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="16dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/lexend_medium"
                        android:text="Usage access"
                        android:textColor="@color/black_90"
                        android:textSize="15sp" />

                    <TextView
                        android:id="@+id/tvUsageStatus"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/lexend"
                        android:text="Required for app-switch signals"
                        android:textColor="@color/black_70"
                        android:textSize="13sp" />
                </LinearLayout>

                <TextView
                    android:id="@+id/btnOpenUsageSettings"
                    android:layout_width="wrap_content"
                    android:layout_height="44dp"
                    android:background="@drawable/bg_onboarding_connect_pill"
                    android:fontFamily="@font/lexend_bold"
                    android:gravity="center"
                    android:minWidth="104dp"
                    android:paddingHorizontal="16dp"
                    android:text="Open Settings"
                    android:textColor="@color/onboarding_accent"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/tvUsageGranted"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/lexend_bold"
                    android:text="✓"
                    android:textColor="@color/onboarding_accent"
                    android:textSize="18sp"
                    android:visibility="gone" />
            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnKeyboardOpenSettings"
        style="@style/Widget.DopaX.Onboarding.PrimaryButton"
        android:text="Open Settings" />

    <TextView
        android:id="@+id/btnKeyboardSkip"
        style="@style/Widget.DopaX.Onboarding.SecondaryLink"
        android:layout_marginTop="12dp"
        android:text="Not now" />
</LinearLayout>
