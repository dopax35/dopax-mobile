<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_onboarding">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingHorizontal="24dp"
        android:paddingTop="56dp">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="7dp"
            android:layout_marginBottom="20dp"
            android:orientation="horizontal">

            <View
                android:layout_width="22dp"
                android:layout_height="7dp"
                android:background="@drawable/onboarding_progress_active" />

            <View
                android:layout_width="7dp"
                android:layout_height="7dp"
                android:layout_marginStart="6dp"
                android:background="@drawable/onboarding_progress_idle" />

            <View
                android:layout_width="7dp"
                android:layout_height="7dp"
                android:layout_marginStart="6dp"
                android:background="@drawable/onboarding_progress_idle" />

            <View
                android:layout_width="7dp"
                android:layout_height="7dp"
                android:layout_marginStart="6dp"
                android:background="@drawable/onboarding_progress_idle" />

            <View
                android:layout_width="7dp"
                android:layout_height="7dp"
                android:layout_marginStart="6dp"
                android:background="@drawable/onboarding_progress_idle" />

            <View
                android:layout_width="7dp"
                android:layout_height="7dp"
                android:layout_marginStart="6dp"
                android:background="@drawable/onboarding_progress_idle" />

            <View
                android:layout_width="7dp"
                android:layout_height="7dp"
                android:layout_marginStart="6dp"
                android:background="@drawable/onboarding_progress_idle" />
        </LinearLayout>

        <TextView
            style="@style/Widget.DopaX.Onboarding.Title"
            android:text="Research consent" />

        <TextView
            android:id="@+id/tvConsentSubtitle"
            style="@style/Widget.DopaX.Onboarding.Subtitle"
            android:layout_marginBottom="12dp"
            android:text="Please read and sign. Presented in English." />

        <TextView
            android:id="@+id/chipLanguage"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:background="@drawable/bg_onboarding_pill"
            android:fontFamily="@font/lexend_medium"
            android:paddingHorizontal="14dp"
            android:paddingVertical="8dp"
            android:text="RTL · עברית"
            android:textColor="@color/onboarding_accent"
            android:textSize="13sp" />

        <androidx.core.widget.NestedScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:fillViewport="true">

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="@color/white"
                app:cardCornerRadius="20dp"
                app:cardElevation="0dp">

                <LinearLayout
                    android:id="@+id/consentContentContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <LinearLayout
                        android:id="@+id/pdfContainer"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="16dp"
                        android:minHeight="240dp"
                        android:orientation="vertical" />

                    <TextView
                        style="@style/Widget.DopaX.Onboarding.FieldLabel"
                        android:text="Full name" />

                    <EditText
                        android:id="@+id/signatureInput"
                        style="@style/Widget.DopaX.Onboarding.Field"
                        android:background="@drawable/bg_onboarding_field"
                        android:hint="Your legal name"
                        android:importantForAutofill="no"
                        android:inputType="textPersonName" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="18dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:fontFamily="@font/lexend"
                            android:text="Sign with your finger"
                            android:textColor="@color/onboarding_text_tertiary"
                            android:textSize="13sp" />

                        <TextView
                            android:id="@+id/btnClearSignature"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="?attr/selectableItemBackground"
                            android:fontFamily="@font/lexend_medium"
                            android:padding="8dp"
                            android:text="Clear"
                            android:textColor="@color/onboarding_accent"
                            android:textSize="13sp" />
                    </LinearLayout>

                    <com.pdcollect.app.ui.view.SignaturePadView
                        android:id="@+id/signaturePad"
                        android:layout_width="match_parent"
                        android:layout_height="100dp"
                        android:layout_marginTop="8dp" />

                    <com.google.android.material.checkbox.MaterialCheckBox
                        android:id="@+id/consentCheckbox"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:text="I have read and understand the above. I voluntarily agree to participate."
                        android:textColor="@color/black_70"
                        android:textSize="14sp"
                        app:buttonTint="@color/onboarding_accent" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </androidx.core.widget.NestedScrollView>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/agreeButton"
            style="@style/Widget.DopaX.Onboarding.PrimaryButton"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="28dp"
            android:enabled="false"
            android:text="I agree — continue" />
    </LinearLayout>
</androidx.coordinatorlayout.widget.CoordinatorLayout>
