<?xml version="1.0" encoding="utf-8"?>
<!-- Onboarding v2 wizard shell. The seven steps below match the iOS
     ProfileSetupView order exactly (about, medications, session windows,
     health apps, interaction primer, reminders primer, ready) so a
     participant sees the same study enrolment on either platform. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_onboarding">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingTop="56dp">

        <LinearLayout
            android:id="@+id/onboardingProgress"
            android:layout_width="wrap_content"
            android:layout_height="7dp"
            android:layout_marginHorizontal="24dp"
            android:layout_marginBottom="20dp"
            android:orientation="horizontal" />

        <ViewFlipper
            android:id="@+id/stepFlipper"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <include layout="@layout/onboarding_step_about" />

            <include layout="@layout/onboarding_step_medications" />

            <include layout="@layout/onboarding_step_times" />

            <include layout="@layout/onboarding_step_health" />

            <include layout="@layout/onboarding_step_keyboard" />

            <include layout="@layout/onboarding_step_reminders" />

            <include layout="@layout/onboarding_step_ready" />
        </ViewFlipper>
    </LinearLayout>
</FrameLayout>
