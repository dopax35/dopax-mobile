<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:paddingHorizontal="24dp"
    android:paddingBottom="28dp">

    <TextView
        style="@style/Widget.DopaX.Onboarding.Title"
        android:text="Connect health apps" />

    <TextView
        style="@style/Widget.DopaX.Onboarding.Subtitle"
        android:text="Optional — activity data helps us see the full picture." />

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingTop="28dp"
        android:paddingBottom="24dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_onboarding_surface"
                android:baselineAligned="false"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="16dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/lexend_medium"
                        android:text="Google Fit / Health Connect"
                        android:textColor="@color/black_90"
                        android:textSize="15sp" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/lexend"
                        android:text="Steps &amp; activity"
                        android:textColor="@color/black_70"
                        android:textSize="13sp" />
                </LinearLayout>

                <TextView
                    android:id="@+id/btnConnectHealthConnect"
                    android:layout_width="wrap_content"
                    android:layout_height="44dp"
                    android:background="@drawable/bg_onboarding_connect_pill"
                    android:fontFamily="@font/lexend_bold"
                    android:gravity="center"
                    android:minWidth="104dp"
                    android:paddingHorizontal="16dp"
                    android:text="Connect"
                    android:textColor="@color/onboarding_accent"
                    android:textSize="14sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_onboarding_surface"
                android:baselineAligned="false"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="16dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/lexend_medium"
                        android:text="Strava"
                        android:textColor="@color/black_90"
                        android:textSize="15sp" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/lexend"
                        android:text="Workouts"
                        android:textColor="@color/black_70"
                        android:textSize="13sp" />
                </LinearLayout>

                <TextView
                    android:id="@+id/btnConnectStrava"
                    android:layout_width="wrap_content"
                    android:layout_height="44dp"
                    android:background="@drawable/bg_onboarding_connect_pill"
                    android:fontFamily="@font/lexend_bold"
                    android:gravity="center"
                    android:minWidth="104dp"
                    android:paddingHorizontal="16dp"
                    android:text="Connect"
                    android:textColor="@color/onboarding_accent"
                    android:textSize="14sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:alpha="0.65"
                android:background="@drawable/bg_onboarding_surface"
                android:baselineAligned="false"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="16dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/lexend_medium"
                        android:text="Apple Health"
                        android:textColor="@color/black_90"
                        android:textSize="15sp" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/lexend"
                        android:text="Sleep &amp; activity · iPhone only"
                        android:textColor="@color/black_70"
                        android:textSize="13sp" />
                </LinearLayout>

                <TextView
                    android:id="@+id/btnConnectAppleHealth"
                    android:layout_width="wrap_content"
                    android:layout_height="44dp"
                    android:enabled="false"
                    android:fontFamily="@font/lexend_bold"
                    android:gravity="center"
                    android:minWidth="104dp"
                    android:paddingHorizontal="16dp"
                    android:text="iPhone only"
                    android:textColor="@color/gray_50"
                    android:textSize="14sp" />
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:fontFamily="@font/lexend"
                android:text="dopa-X only reads workouts and sleep you already recorded. It never writes anything back to these apps."
                android:textColor="@color/onboarding_text_tertiary"
                android:textSize="13sp" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnHealthContinue"
        style="@style/Widget.DopaX.Onboarding.PrimaryButton"
        android:text="Continue" />

    <TextView
        android:id="@+id/btnHealthSkip"
        style="@style/Widget.DopaX.Onboarding.SecondaryLink"
        android:layout_marginTop="12dp"
        android:text="Skip for now" />
</LinearLayout>
