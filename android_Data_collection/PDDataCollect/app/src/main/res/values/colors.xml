<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Dopa-X Brand Palette -->
    <color name="blue_dark">#0F0F3D</color>
    <color name="blue">#2828C6</color>
    <color name="orange">#FF5C35</color>
    <color name="purple">#5B34A4</color>
    <color name="warm_gray">#F0F4F8</color>

    <!-- Onboarding (Figma Dopa-X user app) -->
    <color name="onboarding_cream">#FFF5F1</color>
    <color name="onboarding_accent">#5B34A4</color>
    <color name="onboarding_accent_soft">#6E56C8</color>
    <color name="onboarding_dot_idle">#E4DCE8</color>
    <color name="onboarding_dot_past">#B9AFE8</color>
    <color name="onboarding_text_tertiary">#A3A3A3</color>
    <color name="black">#000000</color>
    <color name="black_90">#3D3D3D</color>
    <color name="black_80">#525252</color>
    <color name="black_70">#666666</color>
    <color name="gray_50">#8F8F8F</color>
    <color name="gray_30">#CCCCCC</color>
    <color name="white">#FFFFFF</color>

    <!-- Semantic Mapping -->
    <color name="primary">@color/blue</color>
    <color name="primary_container">@color/blue_dark</color>
    <color name="secondary">@color/purple</color>
    <color name="tertiary">@color/orange</color>
    <color name="on_surface">@color/black_90</color>
    
    <!-- Surfaces -->
    <color name="surface">@color/white</color>
    <color name="surface_container_low">@color/warm_gray</color>
    <color name="surface_container_lowest">@color/white</color>
    <color name="surface_container_high">@color/gray_30</color>
    
    <!-- Legacy aliases for backwards compatibility -->
    <color name="premium_indigo_deep">@color/blue_dark</color>
    <color name="premium_indigo_light">@color/blue</color>
    <color name="premium_slate_dark">@color/black_90</color>
    <color name="premium_gold_accent">@color/orange</color>
    <color name="gradient_start">@color/orange</color>
    <color name="gradient_end">@color/purple</color>
    
    <color name="outline_variant">@color/gray_30</color>
    <color name="error">#B00020</color>

    <!-- Tonal containers derived from the brand hues, for large surfaces (cards,
         banners) where the saturated brand color itself would be too heavy.
         Added during the July 2026 color-consistency pass to replace one-off
         hex values that had drifted from the brand palette (e.g. a Material
         amber warning banner, and unnamed light-blue/light-purple card tints). -->
    <color name="blue_container">#F8F9FF</color>
    <color name="blue_container_outline">#D1D9FF</color>
    <color name="purple_container">#FDF8FF</color>
    <color name="purple_container_outline">#E6D1FF</color>
    <color name="orange_container">#FFF1EC</color>
    <color name="orange_container_outline">#FFC7B3</color>
    <color name="on_orange_container">#8A3113</color>
    <color name="error_container">#FFF3F3</color>
    <color name="error_container_outline">#FFCDD2</color>

    <!-- Semantic status colors. Meaning (connected/disconnected, live-reading)
         is universal and intentionally distinct from the brand hues above —
         named here instead of left as scattered magic hex duplicates. -->
    <color name="status_success">#4CAF50</color>
    <color name="status_error">#F44336</color>

    <!-- Neutral chrome aliases, named instead of one-off hex duplicates of the
         grays already defined above. -->
    <color name="divider">@color/outline_variant</color>
    <color name="on_header_secondary">#CCFFFFFF</color>
</resources>
