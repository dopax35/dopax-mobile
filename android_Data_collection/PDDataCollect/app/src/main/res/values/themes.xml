<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.PDDataCollect" parent="Theme.Material3.Light.NoActionBar">
        <!-- Core Colors -->
        <item name="colorPrimary">@color/primary</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorPrimaryContainer">@color/primary_container</item>
        <item name="colorSecondary">@color/secondary</item>
        <item name="android:windowBackground">@color/surface</item>
        <item name="colorSurface">@color/surface</item>
        <item name="colorOnSurface">@color/on_surface</item>
        <item name="colorSurfaceVariant">@color/surface_container_high</item>

        <!-- Typography: per DESIGN.md, the app uses Lexend everywhere for its
             improved readability for users with reading-related disabilities.
             Lexend is loaded as a Downloadable Font from Google Play Services
             (see res/font/lexend*.xml) so we don't ship the .ttf binaries. -->
        <item name="android:fontFamily">@font/lexend</item>
        <item name="fontFamily">@font/lexend</item>

        <item name="textAppearanceHeadlineLarge">@style/TextAppearance.DopaX.HeadlineLarge</item>
        <item name="textAppearanceTitleMedium">@style/TextAppearance.DopaX.TitleMedium</item>
        <item name="textAppearanceBodyLarge">@style/TextAppearance.DopaX.BodyLarge</item>

        <!-- Component Styling -->
        <item name="materialButtonStyle">@style/Widget.Material3.Button</item>
        <item name="materialCardViewStyle">@style/Widget.Material3.CardView.Elevated</item>
    </style>

    <style name="TextAppearance.DopaX.HeadlineLarge" parent="TextAppearance.Material3.HeadlineLarge">
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/on_surface</item>
        <item name="android:fontFamily">@font/lexend_bold</item>
        <item name="fontFamily">@font/lexend_bold</item>
    </style>

    <style name="TextAppearance.DopaX.TitleMedium" parent="TextAppearance.Material3.TitleMedium">
        <item name="android:textColor">@color/secondary</item>
        <item name="android:fontFamily">@font/lexend_medium</item>
        <item name="fontFamily">@font/lexend_medium</item>
    </style>

    <style name="TextAppearance.DopaX.BodyLarge" parent="TextAppearance.Material3.BodyLarge">
        <item name="android:textColor">@color/on_surface</item>
        <item name="android:fontFamily">@font/lexend</item>
        <item name="fontFamily">@font/lexend</item>
        <item name="android:lineHeight">24sp</item>
    </style>

    <!-- Onboarding v2 (Figma Dopa-X user app). Shared by the welcome, consent
         and profile-setup wizard steps so the seven screens stay in step with
         each other rather than drifting attribute by attribute. -->
    <style name="Widget.DopaX.Onboarding.Title" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:fontFamily">@font/lexend_bold</item>
        <item name="android:textColor">@color/black_90</item>
        <item name="android:textSize">26sp</item>
    </style>

    <style name="Widget.DopaX.Onboarding.Subtitle" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">8dp</item>
        <item name="android:fontFamily">@font/lexend</item>
        <item name="android:textColor">@color/black_70</item>
        <item name="android:textSize">14.5sp</item>
    </style>

    <style name="Widget.DopaX.Onboarding.FieldLabel" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:fontFamily">@font/lexend_bold</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:textColor">@color/black_70</item>
        <item name="android:textSize">12sp</item>
    </style>

    <style name="Widget.DopaX.Onboarding.Field" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">56dp</item>
        <item name="android:layout_marginTop">8dp</item>
        <item name="android:background">@drawable/bg_onboarding_surface</item>
        <item name="android:fontFamily">@font/lexend</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingEnd">16dp</item>
        <item name="android:textColor">@color/black_90</item>
        <item name="android:textColorHint">@color/gray_50</item>
        <item name="android:textSize">15.5sp</item>
    </style>

    <style name="Widget.DopaX.Onboarding.Segment" parent="">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">54dp</item>
        <item name="android:layout_weight">1</item>
        <item name="android:background">@drawable/bg_onboarding_segment</item>
        <item name="android:fontFamily">@font/lexend_bold</item>
        <item name="android:gravity">center</item>
        <item name="android:textColor">@color/onboarding_segment_text</item>
        <item name="android:textSize">15sp</item>
    </style>

    <style name="Widget.DopaX.Onboarding.PrimaryButton" parent="Widget.Material3.Button">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">54dp</item>
        <item name="android:fontFamily">@font/lexend_bold</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:textSize">16sp</item>
        <item name="backgroundTint">@color/onboarding_primary_button</item>
        <item name="cornerRadius">16dp</item>
        <item name="elevation">0dp</item>
    </style>

    <style name="Widget.DopaX.Onboarding.SecondaryLink" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">48dp</item>
        <item name="android:background">?attr/selectableItemBackground</item>
        <item name="android:fontFamily">@font/lexend_medium</item>
        <item name="android:gravity">center</item>
        <item name="android:textColor">@color/onboarding_text_tertiary</item>
        <item name="android:textSize">14.5sp</item>
    </style>
</resources>


