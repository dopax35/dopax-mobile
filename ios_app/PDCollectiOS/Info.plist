<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>BGTaskSchedulerPermittedIdentifiers</key>
	<array>
		<string>com.pdcollect.ios.bg-refresh</string>
		<string>com.pdcollect.ios.bg-processing</string>
	</array>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>1.0</string>
	<key>CFBundleVersion</key>
	<string>1</string>
	<key>NSBluetoothAlwaysUsageDescription</key>
	<string>This app connects to heart rate monitors and temperature sensors to track health metrics</string>
	<key>NSBluetoothPeripheralUsageDescription</key>
	<string>This app connects to heart rate monitors and temperature sensors to track health metrics</string>
	<key>NSCameraUsageDescription</key>
	<string>This app uses the camera to estimate how far your face is from the screen while you use the app. Processing happens on your device — no photos or video are stored or uploaded.</string>
	<key>NSHealthShareUsageDescription</key>
	<string>This app uses Health data to monitor Parkinson's symptoms</string>
	<key>NSHealthUpdateUsageDescription</key>
	<string>This app writes Health data to track Parkinson's symptoms</string>
	<key>NSMicrophoneUsageDescription</key>
	<string>This app records short voice samples of you reading a story aloud during the Voice Sample task, used to analyze speech patterns related to Parkinson's symptoms.</string>
	<key>NSMotionUsageDescription</key>
	<string>This app uses motion data to detect physical activity and monitor movement patterns</string>
	<key>NSPrincipalClass</key>
	<string>$(PRODUCT_MODULE_NAME).LoggingApplication</string>
	<key>UILaunchStoryboardName</key>
	<string>Launch Screen</string>
	<key>UIRequiresFullScreen</key>
	<true/>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UIBackgroundModes</key>
	<array>
		<string>fetch</string>
		<string>processing</string>
		<string>bluetooth-central</string>
	</array>
	<key>UIAppFonts</key>
	<array>
		<string>Rajdhani-Bold.ttf</string>
		<string>Rajdhani-Medium.ttf</string>
		<string>Rajdhani-Regular.ttf</string>
		<string>Outfit.ttf</string>
	</array>
</dict>
</plist>
