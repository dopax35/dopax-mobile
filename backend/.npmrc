; Machine-local npm config, used via `--userconfig ./.npmrc` to bypass
; ~/.npmrc. The user-level config points npm at the Amdocs corporate proxy
; (genproxy.amdocs.com:8080), which does not resolve off the VPN, so npm hangs
; indefinitely. Direct registry access works fine.
;
; The shell also exports http_proxy/https_proxy without a scheme, which npm
; rejects, so those must be unset for the command as well:
;
;   env -u http_proxy -u https_proxy -u HTTP_PROXY -u HTTPS_PROXY \
;     npm install --userconfig ./.npmrc
;
registry=https://registry.npmjs.org/
strict-ssl=true
