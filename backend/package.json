{
  "name": "@dopax/backend",
  "version": "0.1.0",
  "private": true,
  "description": "DopaX research backend — Node.js + PostgreSQL system of record",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:bootstrap": "tsx scripts/bootstrap.ts",
    "db:inspect": "tsx scripts/db-inspect.ts",
    "staff:add": "tsx scripts/staff-add.ts",
    "drive:inventory": "tsx scripts/drive-inventory.ts",
    "drive:login": "tsx scripts/drive-login.ts",
    "drive:parse": "tsx scripts/drive-parse-zips.ts",
    "db:studio": "drizzle-kit studio",
    "stack:up": "docker compose up -d",
    "stack:down": "docker compose down",
    "stack:reset": "docker compose down -v && docker compose up -d"
  },
  "dependencies": {
    "@fastify/cors": "^11.3.0",
    "@fastify/helmet": "^13.1.0",
    "@fastify/rate-limit": "^11.2.0",
    "csv-parse": "^6.2.1",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.45.2",
    "fastify": "^5.11.3",
    "fastify-plugin": "^6.0.0",
    "firebase-admin": "^13.10.0",
    "google-auth-library": "^10.9.1",
    "jose": "^6.2.8",
    "pg-boss": "^9.0.3",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "postgres": "^3.4.9",
    "yauzl": "^3.4.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@testcontainers/postgresql": "^12.1.0",
    "@types/node": "^26.2.0",
    "@types/yauzl": "^3.4.0",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9.39.5",
    "tsx": "^4.23.11",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.66.0",
    "vitest": "^3.2.7"
  }
}
