# Copy to .env and fill in. Never commit .env or anything under secrets/.

NODE_ENV=development
PORT=8080
LOG_LEVEL=debug

# ─── R3: dual-architecture master switch ────────────────────────────────────
# true  = legacy Google Drive / Apps Script pipeline is authoritative and the
#         new backend runs alongside it, reconciled nightly.
# false = this backend is authoritative and clients stop dual-writing.
BOTH_ARCH=true

# Keeps the Drive drain worker running after the flip, to catch uploads from
# participants still on old app builds. Retire once nothing new arrives for 30 days.
LEGACY_DRIVE_DRAIN=true

# ─── Database ───────────────────────────────────────────────────────────────
# Port 55432, not 5432: the docker-compose Postgres is published there to avoid
# colliding with a native Postgres already listening on 127.0.0.1:5432.
DATABASE_URL=postgres://dopax:dopax@localhost:55432/dopax

# Optional. A managed database to inspect read-only with
# `npm run db:inspect -- --remote`, which opens a read-only transaction and can
# therefore not write. Never point DATABASE_URL itself at production from a
# laptop: R5 requires production to migrate itself through the bootstrap release
# task, and `npm run db:migrate` obeys whatever DATABASE_URL says.
#
# On Railway this is DATABASE_PUBLIC_URL, the public TCP proxy
# (<something>.proxy.rlwy.net:<port>). Railway's internal DATABASE_URL
# (postgres.railway.internal) resolves only inside Railway's private network.
RAILWAY_DATABASE_URL=

# ─── Object storage ─────────────────────────────────────────────────────────
# gdrive = passthrough. Raw ZIPs stay on Google Drive and are stream-parsed;
#          only the parsed rows land in Postgres. Use this on a laptop, where
#          the full corpus will not fit on disk.
# minio  = local S3-compatible storage from docker-compose.
# s3 | azure = production targets.
STORAGE_BACKEND=gdrive

S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=dopax-uploads
S3_ACCESS_KEY_ID=dopax
S3_SECRET_ACCESS_KEY=dopaxdopax
S3_FORCE_PATH_STYLE=true

AZURE_STORAGE_CONNECTION_STRING=
AZURE_STORAGE_CONTAINER=

# ─── Firebase (R1: identity provider stays as-is) ───────────────────────────
# The backend only verifies ID tokens. No credential is ever migrated.
FIREBASE_PROJECT_ID=dopa-x-app
# Optional service account JSON key. Many orgs block key creation
# (iam.disableServiceAccountKeyCreation). Prefer user OAuth instead:
#   1. Create an OAuth Desktop client in Cloud Console
#   2. Save it as secrets/oauth-desktop-client.json
#   3. npm run drive:login
# Leave this unset (or pointing at a missing file) when using user OAuth.
GOOGLE_APPLICATION_CREDENTIALS=
# Optional overrides for the user-OAuth paths (defaults shown):
# DRIVE_OAUTH_CLIENT_PATH=./secrets/oauth-desktop-client.json
# DRIVE_USER_TOKEN_PATH=./secrets/drive-user-token.json

# Local-only escape hatch for working without network access to Google's
# public signing certificates. Hard-refused unless NODE_ENV=development.
AUTH_DEV_BYPASS=false

# ─── Legacy pipeline ────────────────────────────────────────────────────────
LEGACY_DRIVE_FOLDER_ID=1QLsYUTmXIha7rn7wNIJDXVTtrcWoXdly
LEGACY_APPS_SCRIPT_URL=

# ─── R5: first-run data migration ───────────────────────────────────────────
# Directory holding the production exports that `npm run db:bootstrap` imports:
#
#   users.json                     Firebase Auth export
#   master_user_correlations.csv   uid → participant code
#   drive/manifest.jsonl           written by `npm run drive:inventory`
#
# Relative paths resolve from the process working directory, and the npm
# scripts run from backend/, which is what makes '..' the repository root.
# Prefer an absolute path to a directory outside the repository: these files
# carry participant emails and password hashes, and the default is how a copy
# of them ended up committed. In production, mount them and set that path.
MIGRATION_SOURCE_DIR=..

# ─── Backend-issued session tokens ──────────────────────────────────────────
# Generate with: openssl rand -base64 48
JWT_SECRET=
JWT_ACCESS_TTL=900
JWT_REFRESH_TTL=2592000

# ─── Staff admin console (/v1/admin) ────────────────────────────────────────
# Deliberately a different secret from JWT_SECRET: a leaked participant token
# secret must not be able to mint a staff token, and the reverse. Staff sign in
# with Firebase like everyone else, but a token only becomes a staff session if
# the email is an active row in staff_users.
ADMIN_JWT_SECRET=
ADMIN_SESSION_TTL=3600

# Set false to leave /v1/admin unmounted entirely.
ADMIN_API_ENABLED=true

# Development only, and refused unless AUTH_DEV_BYPASS=true and
# NODE_ENV=development. Lets the console sign in by staff email with no Firebase
# credentials present.
ADMIN_DEV_LOGIN=false
